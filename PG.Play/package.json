  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.104.0",
    "framer-motion": "^12.38.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router": "^8.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
