{
  "name": "pg.play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "optimize:covers": "node scripts/optimize-covers.mjs",
    "deploy": "node scripts/deploy.mjs",
    "sim:era-siege": "node scripts/era-siege-sim.mjs",
    "bake:era-siege": "node scripts/era-siege-bake.mjs",
    "process:era-siege-v2": "node scripts/era-siege-process-v2-sheets.mjs",
    "process:era-siege-v1": "node scripts/era-siege-process-v2-sheets.mjs --src assets/era-seige-2/OLD --out public/games/era-siege/v1",
    "import:era-siege-biome": "node scripts/era-siege-import-biome.mjs",
    "import:era-siege": "node scripts/era-siege-import-sheets.mjs",
