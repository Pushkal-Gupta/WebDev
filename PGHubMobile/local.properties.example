# Copy this file to `local.properties` and fill in real values.
# `local.properties` is git-ignored and must NEVER be committed.

# Android SDK location (Android Studio sets this automatically on first sync).
sdk.dir=/Users/YOUR_USER/Library/Android/sdk

# PG Hub Supabase project. These are injected into BuildConfig at build time.
# The anon key is a public client key (safe for a client app) but is still
# kept out of source control so the repo stays credential-free.
SUPABASE_URL=https://ykpjmvoyatcrlqyqbgfu.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
